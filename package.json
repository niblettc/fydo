{
  "name": "fydo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "supabase"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @fydo/web",
    "dev:server": "npm run dev --workspace @fydo/server",
    "build": "npm run build --workspaces --if-present",
    "lint": "oxlint",
    "smoke": "npm run smoke --workspace @fydo/core"
  },
  "devDependencies": {
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2"
  }
}
