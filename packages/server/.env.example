# Anthropic key used for the mandatory AI reviews (server-side only)
ANTHROPIC_API_KEY=sk-ant-...

# Supabase project, used to validate user JWTs on the AI review endpoint
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Neo4j (docker compose defaults)
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=fydo-graph

# Fallback GitHub token when the client doesn't send one
# GITHUB_TOKEN=

# PORT=8787
# INGEST_MAX_FILES=1500
