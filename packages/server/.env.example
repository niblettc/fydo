# Neo4j connection (defaults match docker-compose.yml at the repo root)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=fydo-graph

# HTTP port for the API
PORT=8787

# Optional fallback GitHub token used when the web client doesn't send one
# GITHUB_TOKEN=ghp_...

# Cap on files parsed during repo ingestion
# INGEST_MAX_FILES=1500
